# Caddyfile — self-host курса-сайта на Vultr (авто-TLS Let's Encrypt) + фаза B same-origin.
# Живёт на VM в /etc/caddy/Caddyfile. Домен: lessons.tellian.io → A-запись на IP VM.
#
# Фаза A: статика из /var/www/course-site. Фаза B: Umami (/stats) + Remark42 (/comments)
# проксируются на localhost-контейнеры (docker-compose в deploy/phase-b/) — one-origin,
# без CORS, TLS терминируется здесь.

lessons.tellian.io {
	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Umami (аналитика: просмотры + scroll-глубина). data-host-url в шаблоне = /stats
	handle_path /stats/* {
		reverse_proxy 127.0.0.1:3000
	}
	# Remark42 (комментарии/реакции/RSS). REMARK_URL = https://.../comments
	handle_path /comments/* {
		reverse_proxy 127.0.0.1:8080
	}

	# Статика курса (fallback)
	handle {
		root * /var/www/course-site
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}
