# Caddyfile — origin за Gcore CDN (RU-доступ). Живёт на VM в /etc/caddy/Caddyfile.
#
# Схема: пользователь → Gcore edge (HTTPS, LE) → origin (этот Caddy, HTTP) → статика + Umami/Remark42.
# Gcore тянет с origin по HTTP (originProtocol=HTTP, hostHeader=lessons.tellian.io), поэтому origin
# отдаёт и http://, и https:// БЕЗ редиректа (иначе Gcore получал бы 308). TLS для юзеров — на edge.
#
# DNS: lessons.tellian.io = CNAME → cl-gl845efb71.gcdn.co (Gcore). Origin Gcore знает по IP.

http://lessons.tellian.io, https://lessons.tellian.io {
	log
	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Umami (аналитика: просмотры + scroll-глубина) — same-origin через /stats
	handle_path /stats/* {
		reverse_proxy 127.0.0.1:3000
	}
	# Remark42 (комментарии/реакции/RSS) — same-origin через /comments
	handle_path /comments/* {
		reverse_proxy 127.0.0.1:8080
	}

	# Статика курса (кэшируется на Gcore; /assets — immutable)
	handle {
		root * /var/www/course-site
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}
