# Copy to .env (git-ignored) and fill in real values.
# .env lives per-worktree; the durable copy is at the main checkout's repo
# root (publishing-ba444454/.env) — a new task worktree that needs one of
# these should copy it from there rather than asking the owner to re-paste
# a secret that already exists.

# WordPress.com Atomic — used by scripts/wp_publish.py (SHIP mechanics)
WP_API_BASE=
WP_USER=
WP_APP_PASSWORD=

# OpenRouter — used for generative-illustration experiments (image models
# called via OpenRouter, e.g. Qwen Image 2.1 Pro)
OPENROUTER_API_KEY=
